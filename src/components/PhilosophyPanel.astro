---
interface Props {
  item: {
    colour: string
    hex: string
    title: string
    theoristQuote: string
    theorist: string
    familyQuote: string
    familyName: string
    description: string
  }
}

const { item } = Astro.props
---

<div class="philosophy-panel" style={`--band:${item.hex}`}>
  <div>
    <p class="philosophy-colour">{item.colour}</p>
    <h3>{item.title}</h3>
    <p class="philosophy-description">{item.description}</p>
  </div>
  <div>
    <blockquote class="philosophy-quote">
      <p>‘{item.theoristQuote}’</p>
      <cite>{item.theorist}</cite>
    </blockquote>
    <blockquote class="philosophy-quote philosophy-quote-family">
      <p>‘{item.familyQuote}’</p>
      <cite>{item.familyName}</cite>
    </blockquote>
  </div>
</div>
