---
import { Image, getImage } from 'astro:assets';
import logoSrc from '../assets/current-site/betty_logo.jpg';
import ogImageSrc from '../assets/current-site/outdoor4.jpeg';

const optimizedOgImage = await getImage({ src: ogImageSrc, width: 1200, format: 'webp' });

const navItems = [
  { label: 'About Betty’s', href: '#about' },
  { label: 'A Day at Betty’s', href: '#day' },
  { label: 'Fees', href: '#fees' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Visit', href: '#visit' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ChildCare',
  name: 'Betty Spears Child Care Centre',
  url: 'https://bettyspearschildcare.org.au/',
  telephone: '+61295588350',
  email: 'office@bettyspearschildcare.org.au',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1A Gannon St',
    addressLocality: 'Tempe',
    addressRegion: 'NSW',
    postalCode: '2044',
    addressCountry: 'AU',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '07:30',
    closes: '18:00',
  },
  foundingDate: '1986',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Betty Spears Child Care Centre in Tempe offers community-based early learning and long day care for children from 6 weeks to 6 years."
    />
    <meta
      name="keywords"
      content="childcare Tempe, daycare Tempe, preschool Tempe, long day care, Betty Spears Child Care Centre"
    />
    <meta property="og:title" content="Betty Spears Child Care Centre" />
    <meta
      property="og:description"
      content="A place where children belong. Community-based childcare in Tempe, since 1986."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(optimizedOgImage.src, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo:wght@400;500;600;700;800&family=Comfortaa:wght@400;500;600;700&family=Varela+Round&display=swap" rel="stylesheet" />
    <link rel="canonical" href="https://bettyspearschildcare.org.au/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Betty Spears Child Care Centre</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body>
    <div class="site-shell" id="top">
      <header class="site-header">
        <div class="container site-header-inner">
          <a class="brand" href="#top" aria-label="Betty Spears home">
            <span class="brand-copy">
              <strong class="brand-name">Betty Spears</strong>
              <small>Child Care Centre</small>
            </span>
          </a>

          <nav class="main-nav" aria-label="Main navigation">
            {navItems.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>

          <div class="top-cta-group">
            <a class="top-cta" href="#visit">Book a Visit</a>
            <a class="top-cta-secondary" href="#waiting-list">Join Waitlist</a>
          </div>
        </div>
      </header>

      <slot />

      <footer class="site-footer">
        <div class="container footer-inner">
          <div class="footer-brand">
            <Image class="footer-logo" src={logoSrc} height={200} alt="Betty Spears Child Care Centre logo" />
            <div>
              <strong>Betty Spears Child Care Centre</strong><br />
              Community-based early learning in Tempe
            </div>
          </div>
          <div class="footer-links">
            <a href="#visit">Visit</a>
            <a href="#faq">FAQ</a>
            <a href="/families">Families</a>
            <a href="#waiting-list">Waiting list</a>
          </div>
        </div>
      </footer>
    </div>

    <a class="top-cta sticky-cta" href="#waiting-list">Join Waitlist</a>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
