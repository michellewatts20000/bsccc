---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <section class="section">
      <div class="container">
        <p class="section-kicker">Family resources</p>
        <h1 class="section-heading">Current family information</h1>
        <p class="section-lead">
          This page is reserved for family-specific resources such as policies, forms, illness guidance,
          immunisation information and administrative updates.
        </p>
      </div>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="container section-panel">
        <div class="community-copy">
          <p>
            This section can be expanded with policies, parent forms, NQS documentation and practical
            information for current families only.
          </p>
          <div class="community-stats">
            <div class="story-note">
              <strong>Policies</strong>
              <span>Access official centre policies and updates.</span>
            </div>
            <div class="story-note">
              <strong>Forms</strong>
              <span>Enrolment and administrative documents.</span>
            </div>
            <div class="story-note">
              <strong>Resources</strong>
              <span>Illness, immunisation and family guidance.</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
