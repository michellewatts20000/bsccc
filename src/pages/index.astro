const faqs = [
  {
    q: 'What ages do you accept?',
    a: 'Betty Spears welcomes children from approximately 6 weeks to 6 years across three rooms: Ducklings (6 weeks–2 years), the Middle room (2–3 years) and our Preschool room (3–6 years).'
  },
  {
    q: 'What are your opening hours?',
    a: 'The centre is open Monday to Friday, 7:30am–6:00pm, with a strong focus on long-day care and smooth family routines.'
  },
  {
    q: 'Are you open all year round?',
    a: 'We’re open 50 weeks a year and close for two weeks over Christmas and New Year, when fees aren’t payable.'
  },
  {
    q: 'How does Child Care Subsidy work?',
    a: 'Families may be eligible for Child Care Subsidy through Services Australia. Our team can explain the process and guide you through the application and enrolment steps.'
  },
  {
    q: 'What is your National Quality Standard rating?',
    a: 'Betty Spears was assessed against the National Quality Standard in August 2023 and rated as Meeting the Standard overall, while Exceeding in three of the seven Quality Areas.'
  },
  {
    q: 'How does the waiting list work?',
    a: 'Families can submit a waiting list application and pay the applicable waiting list fee. Once your application is received, we’ll confirm it and contact you when a place becomes available.'
  },
  {
    q: 'How long can the waiting list take?',
    a: 'Waiting times vary depending on age group and availability. We recommend joining the list as early as possible and staying in touch with the centre as your circumstances change.'
  },
  {
    q: 'Do you provide meals?',
    a: 'Yes. Fresh meals are prepared at the centre and planned with children’s nutrition, routines and dietary needs in mind.'
  },
  {
    q: 'Do you provide nappies?',
    a: 'No, daily fees include everything your child will need in a day except formula for babies and nappies for all children using them.'
  },
  {
    q: 'How do we arrange a visit?',
    a: 'You can contact the centre to arrange a visit, speak with the team and see the environment in person. We’re always happy to show families around and answer questions.'
  }
]
---

<Layout>
  <main>
    <section class="hero" id="top">
      <div class="hero-media" aria-hidden="true">
        {
          heroSlides.map((slide, i) =>
            i === 0 ? (
              <img
                class="hero-slide is-active"
                src={slide.src}
                srcset={slide.srcSet.attribute}
                sizes="100vw"
                width={slide.attributes.width}
                height={slide.attributes.height}
                alt=""
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <img
                class="hero-slide"
                data-src={slide.src}
                data-srcset={slide.srcSet.attribute}
                sizes="100vw"
                width={slide.attributes.width}
                height={slide.attributes.height}
                alt=""
                decoding="async"
              />
            )
          )
        }
      </div>

      <div class="container hero-content">
        <h1>
          <span class="accent">Betty Spears</span>
          Child Care Centre & Preschool
        </h1>
        <div
          class="hero-mark"
          aria-hidden="true"
          set:html={featureIcons.nature}
        />
        <p class="hero-intro">
          Betty Spears is a not-for-profit, community-based long day care centre
          and preschool that has been operating in Tempe since 1986.
        </p>

        <div class="hero-actions">
          <a href="#" class="button-primary" aria-disabled="true"
            >Book a Visit</a
          >
          <a href="#" class="button-secondary" aria-disabled="true"
            >Join Waitlist</a
          >
        </div>
      </div>

      <button
        type="button"
        class="hero-pause"
        aria-label="Pause slideshow"
        hidden
      >
        <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect
            x="14"
            y="5"
            width="4"
            height="14"
            rx="1"></rect></svg
        >
        <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"
          ></path></svg
        >
      </button>
    </section>

    <section
      class="impact-band impact-band-compact"
      aria-label="Key facts about the centre"
    >
      <div class="container impact-grid">
        {
          keyFacts.map((item) => (
            <div
              class="stat-item impact-item"
              style={`--impact-color: ${item.color}`}
            >
              <div
                class="impact-icon"
                aria-hidden="true"
                set:html={impactIcons[item.icon]}
              />
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-heading">
      <div class="container">
        <h2 class="visually-hidden" id="about-heading">About Betty’s</h2>
        <div class="about-carousel" data-carousel>
          <div class="about-carousel-viewport">
            <div class="about-slide is-active">
              <div class="about-slide-text">
                <p class="section-kicker" style="margin-bottom: 0.6rem;">
                  About us
                </p>
                <h3 class="subheading">Run by families, for families</h3>

                <p>
                  Betty Spears is a not-for-profit, parent-governed centre where
                  decisions are shaped by families and community. Not-for-profit
                  means that all of the income we receive in fees and Government
                  subsidies goes directly to the centre budget to be used for
                  the benefit of children and families.
                </p>
                <p>
                  The day to day running of the centre is the responsibility of
                  the Centre Director who reports to our volunteer Board of
                  Directors – all parents themselves. The Centre Director and
                  Board meet each month to discuss issues relating to the centre
                  operation and all parents whose children attend Betty’s are
                  welcome to attend.
                </p>
              </div>
              <div class="about-slide-visual">
                <Image
                  src={familyImage}
                  widths={[480, 720, 1000]}
                  sizes="(max-width: 980px) calc(100vw - 2rem), 590px"
                  alt="Children engaged in imaginative indoor play at Betty Spears"
                />
              </div>
            </div>
            <div class="about-slide">
              <div class="about-slide-text">
                <p class="section-kicker" style="margin-bottom: 0.6rem;">
                  Relationships
                </p>
                <h3 class="subheading">
                  It really is about the relationships at Betty’s
                </h3>
                <p>
                  Relationships between children and educators are based on
                  mutual trust and respect. All children feel known, celebrated
                  and cared for by all educators in the centre.
                </p>
                <p>
                  Children and families see familiar, happy and caring faces
                  every time they enter the centre. Betty's has a warm,
                  second-home atmosphere where educators can share their own
                  unique interests and passions with children, fostering
                  authentic and meaningful connections.
                </p>
                <p>
                  There is a sense of real presense and belonging among all
                  members of the Betty's community. Our policies and procedures
                  ensure that the rostering of staff is child-focussed, flexible
                  and available to parents, responding to the needs of children
                  and families.
                </p>
              </div>
              <div class="about-slide-visual">
                <Image
                  src={groupImage}
                  widths={[480, 720, 1000]}
                  sizes="(max-width: 980px) calc(100vw - 2rem), 590px"
                  alt="A child painting a cardboard tube at the art table"
                />
              </div>
            </div>

            <div class="about-slide">
              <div class="about-slide-text">
                <p class="section-kicker" style="margin-bottom: 0.6rem;">
                  Nature
                </p>
                <h3 class="subheading">Time outdoors, every day</h3>
                <p>
                  Betty’s is known for its generous natural outdoor spaces,
                  where children run, dig, climb, notice and explore. Fresh air
                  and open-ended play are part of the rhythm of every day.
                </p>
                <p>
                  We value risky play – climbing a little higher, balancing
                  along logs and testing their own limits – because that’s how
                  children build confidence, resilience and good judgement, with
                  educators close by to support them.
                </p>
                <p>
                  Sustainability is part of daily life too. Children help with
                  recycling, water the vegetable garden and learn what it means
                  to care for the world around them. Even our youngest have
                  their own patch, with a sensory walk and vegetable garden in
                  the Ducklings outdoor area.
                </p>
              </div>
              <div class="about-slide-visual">
                <Image
                  src={bushGardenImage}
                  widths={[480, 720, 1000]}
                  sizes="(max-width: 980px) calc(100vw - 2rem), 590px"
                  alt="The bush garden at Betty Spears"
                />
              </div>
            </div>

            <div class="about-slide">
              <div class="about-slide-text">
                <p class="section-kicker" style="margin-bottom: 0.6rem;">
                  Part of the neighbourhood
                </p>
                <h3 class="subheading">Woven into the local community</h3>
                <p>
                  Betty’s is well known in the local area and we continue to
                  build relationships with individuals and organisations within
                  our area.
                </p>
                <p>
                  Many of our families have shared several of their children
                  with us over the course of years. We even have some parents
                  and staff at Betty’s that came to Betty’s as children
                  themselves.
                </p>
              </div>
              <div class="about-slide-visual">
                <Image
                  src={educatorImage2}
                  widths={[480, 720, 1000]}
                  sizes="(max-width: 980px) calc(100vw - 2rem), 590px"
                  alt="An educator reading with a group of children outdoors"
                />
              </div>
            </div>

            <div class="about-slide">
              <div class="about-slide-text">
                <p class="section-kicker" style="margin-bottom: 0.6rem;">
                  Our educators
                </p>
                <h3 class="subheading">Long serving educators</h3>
                <p>
                  The long-serving nature of our educators is one of Betty’s
                  greatest strengths. Families know they can trust familiar
                  faces, stable routines and deep relationships that grow over
                  time.
                </p>
                <p>
                  We care about our staff and are proud of the fact that we have
                  minimal staff turnover at Betty’s. Our longest serving members
                  of staff have been at Betty’s for over twenty years with many
                  of our Educators working at Betty’s for close to ten years.
                </p>
                <p>
                  Every room has a university-qualified Early Childhood Teacher
                  alongside Diploma-qualified educators, plus our own trusted
                  list of permanent relief staff, so a sick day never means an
                  unfamiliar face.
                </p>
              </div>
              <div class="about-slide-visual">
                <Image
                  src={educatorImage1}
                  widths={[480, 720, 1000]}
                  sizes="(max-width: 980px) calc(100vw - 2rem), 590px"
                  alt="An educator sitting with a group of children during circle time"
                />
              </div>
            </div>
          </div>

          <div class="about-carousel-controls">
            <button
              type="button"
              class="carousel-arrow carousel-arrow-prev"
              aria-label="Previous slide"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M19 12H5M11 6l-6 6 6 6"></path></svg
              >
            </button>
            <button
              type="button"
              class="carousel-arrow carousel-arrow-next"
              aria-label="Next slide"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
              >
            </button>
            <p class="carousel-count" aria-live="polite"></p>
          </div>
        </div>
        <div class="feature-grid">
          {
            whyItems.map((item) => (
              <article class="feature-card">
                <div
                  class="feature-icon"
                  aria-hidden="true"
                  set:html={featureIcons[item.icon]}
                />
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
        <p class="section-kicker" style="margin-top: 4rem;">
          Our outdoor spaces
        </p>
        <h3 class="subheading">Room to run, dig, climb and explore</h3>
        <div class="outdoor-grid">
          {
            outdoorSpaces.map((space) => (
              <figure class="outdoor-tile">
                <Image src={space.image} widths={[300, 450, 600]}
                  sizes="(max-width: 980px) calc(50vw - 1.5rem), 290px" alt={space.alt} />
                <figcaption>{space.caption}</figcaption>
              </figure>
            ))
          }
        </div>

        <div class="founder-wrap">
          <div class="founder-visual">
            <figure class="founder-card">
              <Image
                src={differenceImage}
                width={320}
                class="founder-portrait"
                alt="An archival portrait of the late Betty Spears"
              />
              <figcaption>Betty Spears, 1926–2012</figcaption>
            </figure>
          </div>
          <div>
            <p class="section-kicker" style="margin-bottom: 0.6rem;">
              Our story
            </p>
            <h2 class="section-heading" style="margin: 0 0 0.9rem;">
              Betty's was established in 1986
            </h2>
            <p class="section-lead" style="margin-top: 0;">
