  <script>
    const contactForm = document.getElementById('contact-form')
    contactForm?.addEventListener('submit', (event) => {
      event.preventDefault()
      const data = new FormData(contactForm as HTMLFormElement)
      const subject = String(data.get('subject') ?? 'General Enquiry')
      const name = String(data.get('name') ?? '')
      const email = String(data.get('email') ?? '')
      const message = String(data.get('message') ?? '')
      const body = `From: ${name} (${email})\n\n${message}`
      const mailto = `mailto:office@bettyspearschildcare.org.au?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
      window.location.href = mailto
    })

    const subjectSelect = contactForm?.querySelector<HTMLSelectElement>(
      'select[name="subject"]'
    )
    document
      .querySelectorAll<HTMLAnchorElement>('a[data-subject]')
      .forEach((link) => {
        link.addEventListener('click', () => {
          if (subjectSelect && link.dataset.subject) {
            subjectSelect.value = link.dataset.subject
          }
        })
      })

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches

    // Stats are only hidden (via the .js class on <html>) when this script runs
    const statItems = document.querySelectorAll<HTMLElement>('.stat-item')
    if (statItems.length) {
      const statsObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              statsObserver.unobserve(entry.target)
            }
          })
        },
        { threshold: 0.3 }
      )
      statItems.forEach((item) => statsObserver.observe(item))
    }

    const revealGrids = document.querySelectorAll<HTMLElement>(
      '.photo-grid, .outdoor-grid'
    )
    if (revealGrids.length) {
      const gridObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              gridObserver.unobserve(entry.target)
            }
          })
        },
        { threshold: 0.2 }
      )
      revealGrids.forEach((grid) => {
        grid.classList.add('reveal')
        gridObserver.observe(grid)
      })
    }

    document
      .querySelectorAll<HTMLElement>('[data-carousel]')
      .forEach((carousel) => {
        const viewport = carousel.querySelector<HTMLElement>(
          '.about-carousel-viewport'
        )
        const slides = viewport
          ? (Array.from(viewport.children) as HTMLElement[])
          : []
        const count = carousel.querySelector<HTMLElement>('.carousel-count')
        const prevButton = carousel.querySelector<HTMLButtonElement>(
          '.carousel-arrow-prev'
        )
        const nextButton = carousel.querySelector<HTMLButtonElement>(
          '.carousel-arrow-next'
        )
        if (!slides.length) return

        let current = Math.max(
          slides.findIndex((slide) => slide.classList.contains('is-active')),
          0
        )

        const showSlide = (index: number, direction?: 'next' | 'prev') => {
          slides[current]?.classList.remove('is-active')
          delete slides[current]?.dataset.enter
          current = (index + slides.length) % slides.length
          slides[current]?.classList.add('is-active')
          if (direction) slides[current].dataset.enter = direction
          if (count) count.textContent = `${current + 1} / ${slides.length}`
        }

        showSlide(current)

        prevButton?.addEventListener('click', () =>
          showSlide(current - 1, 'prev')
        )
        nextButton?.addEventListener('click', () =>
          showSlide(current + 1, 'next')
        )
      })

    // Only the first hero photo is in the HTML; the rest load one step ahead
    const heroSlides = Array.from(
      document.querySelectorAll<HTMLImageElement>('.hero-slide')
    )
    const heroPause = document.querySelector<HTMLButtonElement>('.hero-pause')

    const loadHeroSlide = (slide?: HTMLImageElement) => {
      if (!slide?.dataset.src) return
      slide.srcset = slide.dataset.srcset ?? ''
      slide.src = slide.dataset.src
      delete slide.dataset.src
      delete slide.dataset.srcset
    }

    if (heroSlides.length > 1 && !prefersReducedMotion) {
      let currentSlide = 0
      let timer: number | undefined

      const nextHeroSlide = () => {
        heroSlides[currentSlide].classList.remove('is-active')
        currentSlide = (currentSlide + 1) % heroSlides.length
        heroSlides[currentSlide].classList.add('is-active')
        loadHeroSlide(heroSlides[(currentSlide + 1) % heroSlides.length])
      }
      const playHero = () => {
        timer = window.setInterval(nextHeroSlide, 6000)
      }

      // Give the first photo and the rest of the page the bandwidth first
      const loadSecondSlide = () =>
        window.setTimeout(() => loadHeroSlide(heroSlides[1]), 2000)
      if (document.readyState === 'complete') loadSecondSlide()
      else window.addEventListener('load', loadSecondSlide, { once: true })
      playHero()

      if (heroPause) {
        heroPause.hidden = false
        heroPause.addEventListener('click', () => {
          const pausing = timer !== undefined
          if (pausing) {
            window.clearInterval(timer)
            timer = undefined
          } else {
            playHero()
          }
          heroPause.classList.toggle('is-paused', pausing)
          heroPause.setAttribute(
            'aria-label',
            pausing ? 'Play slideshow' : 'Pause slideshow'
          )
        })
      }
    }
  </script>
