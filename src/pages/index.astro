const impactIcons: Record<string, string> = {
  people:
    '<svg viewBox="0 0 64 64" fill="currentColor"><circle cx="22" cy="18" r="9"/><circle cx="44" cy="22" r="7.5"/><path d="M5 54c0-11 7.6-19 17-19s17 8 17 19Z"/><path d="M36 54c0-6.5-2-12-5.6-15.6A13 13 0 0 1 44 33c8 0 14 7 14 16v5Z"/></svg>',
  blocks:
    '<svg viewBox="0 0 64 64" fill="currentColor"><rect x="6" y="34" width="24" height="24" rx="4"/><rect x="34" y="34" width="24" height="24" rx="4"/><rect x="20" y="7" width="24" height="24" rx="4"/></svg>',
  clock:
    '<svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="currentColor"/><path d="M32 17v16l10 7" fill="none" stroke="#3b7a19" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  sprout:
    '<svg viewBox="0 0 64 64" fill="currentColor"><path d="M10 58c0-10 10-16 22-16s22 6 22 16Z"/><rect x="30" y="26" width="4" height="20" rx="2"/><path d="M30 34C17 34 9 26 9 13c13 0 21 8 21 21Z"/><path d="M34 29c0-14 9-22 22-22 0 14-9 22-22 22Z"/></svg>',
  heart:
