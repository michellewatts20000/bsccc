---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import heroImage from '../assets/current-site/renovated_play_one.jpeg'
import differenceImage from '../assets/current-site/betty_image.png'
import learningImage from '../assets/current-site/outdoor_painting.jpeg'
import outdoorImage1 from '../assets/current-site/outdoor_garden_wide.jpeg'
import outdoorImage2 from '../assets/current-site/outdoor_bush_garden.jpeg'
import outdoorGardenImage from '../assets/current-site/outdoor_garden.jpeg'
import foodImage1 from '../assets/current-site/food-1.jpeg'
import foodImage2 from '../assets/current-site/food-2.jpeg'
import foodImage3 from '../assets/current-site/food-3.jpeg'
import foodImage4 from '../assets/current-site/food-4.jpeg'
import foodImage5 from '../assets/current-site/food-5.jpeg'
import groupImage from '../assets/current-site/indoor_painting.jpeg'
import educatorImage1 from '../assets/current-site/indoor_bus.jpeg'
import educatorImage2 from '../assets/current-site/outdoor_reading.jpeg'
import familyImage from '../assets/current-site/indoor_trains.jpeg'
import feesImage from '../assets/current-site/renovated_play_four.jpeg'
import bushGardenImage from '../assets/current-site/bush-garden-1.jpeg'
import ducklingsImage from '../assets/current-site/ducklinks-play-area.jpeg'
import frontSignImage from '../assets/current-site/bettys-front-sign-2.jpg'
import ducklingsOutdoorImage from '../assets/current-site/duckliings-outdoor-1.jpg'

const feeTable = [
  { age: 'Under 2 years', fee: '$178.50' },
  { age: '2–3 years', fee: '$176.20' },
  { age: '3–5 years', fee: '$176.00' }
]

const philosophyItems = [
  {
    letter: 'C',
    title: 'Community & belonging',
    description:
      'A community-based centre fostering respect and understanding for ourselves, each other and the wider community.'
  },
  {
    letter: 'H',
    title: 'Health & wellbeing',
    description:
      'Emotional and physical wellbeing come first, so every child feels secure enough to fully engage and enjoy their day.'
  },
  {
    letter: 'I',
    title: 'Inclusion',
    description:
      'We welcome all children and families and work to maintain a culturally safe, culturally inclusive centre where everyone feels connected.'
  },
  {
    letter: 'L',
    title: 'Learning from interest',
    description:
      'Children are capable, competent co-contributors in their own learning, exploring at their own pace and following their interests.'
  },
  {
    letter: 'D',
    title: 'Development: being & becoming',
    description:
      'We meet children where they are and help them grow, while supporting educators’ ongoing development too.'
  },
  {
    letter: 'R',
    title: 'Relationships & rights',
    description:
      'Meaningful relationships built on trust and respect, so Betty’s feels like a home away from home for children and families alike.'
  },
  {
    letter: 'E',
    title: 'Environment',
    description:
      'Time, space and freedom for children to investigate and explore the world in their own way.'
  },
  {
    letter: 'N',
    title: 'Nature',
    description:
      'Daily opportunities to explore our large natural outdoor space, and to learn what it means to care for the world around us.'
  }
]

const whyItems = [
  {
    icon: 'relationships',
    title: 'Relationships',
    description:
      'Children build strong, familiar relationships with educators who know them and care about them.'
  },
  {
    icon: 'community',
    title: 'Community',
    description:
      'Betty’s is community-based, not-for-profit and shaped by the families who call it home.'
  },
  {
    icon: 'nature',
    title: 'Nature',
    description:
      'Big natural outdoor spaces where children can run, dig, climb and explore.'
  },
  {
    icon: 'familiar-faces',
    title: 'Familiar faces',
    description:
      'Educators who stay for years, so children grow up surrounded by people they know and trust.'
  },
  {
    icon: 'fresh-food',
    title: 'Fresh food',
    description:
      'Meals made in-house, with a focus on fresh food and slow, unhurried mealtimes.'
  }
]

const featureIcons: Record<string, string> = {
  relationships:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="12" r="5.5"/><circle cx="15" cy="12" r="5.5"/></svg>',
  community:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11.5 12 4l8 7.5"/><path d="M6 10v9.5a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V10"/><path d="M10 20.5v-6h4v6"/></svg>',
  nature:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c8 1 14-5 14-14C10 5 4 11 5 19Z"/><path d="M6 18c3-3.5 5.5-6.5 12.5-12"/></svg>',
  'familiar-faces':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M9 10.5h.01M15 10.5h.01"/><path d="M8.5 14.5c1 1.3 2.2 2 3.5 2s2.5-.7 3.5-2"/></svg>',
  'fresh-food':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16a8 6 0 0 1-16 0Z"/><path d="M9 4.5c-.6.8-.6 1.4 0 2M12 4c-.6.8-.6 1.4 0 2"/></svg>'
}

const faqs = [
  {
    q: 'What ages do you accept?',
    a: 'Betty Spears welcomes children from approximately 6 weeks to 6 years, with the centre structured around care, play and early learning across different age groups.'
  },
  {
    q: 'What are your opening hours?',
    a: 'The centre is open Monday to Friday, 7:30am–6:00pm, with a strong focus on long-day care and smooth family routines.'
  },
  {
    q: 'Are you open all year round?',
    a: 'We’re open 50 weeks a year and close for two weeks over Christmas and New Year, when fees aren’t payable.'
  },
  {
    q: 'How does Child Care Subsidy work?',
    a: 'Families may be eligible for Child Care Subsidy through Services Australia. Our team can explain the process and guide you through the application and enrolment steps.'
  },
  {
    q: 'What is your National Quality Standard rating?',
    a: 'Betty Spears was assessed against the National Quality Standard in August 2023 and rated as Meeting the Standard overall, while Exceeding in three of the seven Quality Areas.'
  },
  {
    q: 'How does the waiting list work?',
    a: 'Families can submit a waiting list application and pay the applicable waiting list fee. Once your application is received, we’ll confirm it and contact you when a place becomes available.'
  },
  {
    q: 'How long can the waiting list take?',
    a: 'Waiting times vary depending on age group and availability. We recommend joining the list as early as possible and staying in touch with the centre as your circumstances change.'
  },
  {
    q: 'Do you provide meals?',
    a: 'Yes. Fresh meals are prepared at the centre and planned with children’s nutrition, routines and dietary needs in mind.'
  },
  {
    q: 'Do you provide nappies?',
    a: 'No, daily fees include everything your child will need in a day except formula for babies and nappies for all children using them.'
  },
  {
    q: 'How do we arrange a visit?',
    a: 'You can contact the centre to arrange a visit, speak with the team and see the environment in person. We’re always happy to show families around and answer questions.'
  }
]
---

<Layout>
  <main>
    <section class="hero" id="top">
      <div class="hero-media">
        <Image
          class="hero-slide is-active"
          src={heroImage}
          width={1920}
          loading="eager"
          fetchpriority="high"
          alt="The newly renovated outdoor play space and centre building at Betty Spears"
        />
        <Image
          class="hero-slide"
          src={outdoorImage1}
          width={1920}
          loading="eager"
          alt="Children walking the garden pathway at Betty Spears"
        />
        <Image
          class="hero-slide"
          src={outdoorImage2}
          width={1920}
          loading="eager"
          alt="Children playing at the mud kitchen and water play area at Betty Spears"
        />
        <Image
          class="hero-slide"
          src={educatorImage2}
          width={1920}
          loading="eager"
          alt="An educator reading with a group of children outdoors"
        />
        <Image
          class="hero-slide"
          src={frontSignImage}
          width={1920}
          loading="eager"
          alt="The Betty Spears Child Care Centre front sign"
        />
      </div>

      <div class="container hero-content">
        <h1>
          Betty Spears <br /><span class="accent">Child Care Centre</span>
        </h1>
        <p class="hero-intro">
          Betty Spears Child Care Centre is a not for profit, community based,
          long day care centre that has been operating in Tempe since 1986.
        </p>

        <div class="hero-actions">
          <a href="#" class="button-primary" aria-disabled="true"
            >Book a Visit</a
          >
          <a href="#" class="button-secondary" aria-disabled="true"
            >Join Waitlist</a
          >
        </div>
      </div>
    </section>

    <section class="stats-strip" aria-label="Key facts about the centre">
      <div class="container stats-grid">
        <div class="stat-item">
          <strong>Not-for-profit</strong>
          <span>Built around community and family needs.</span>
        </div>
        <div class="stat-item">
          <strong>Long day care</strong>
          <span>For children <br />6 weeks–6 years of age</span>
        </div>
        <div class="stat-item">
          <strong>Open Mon–Fri</strong>
          <span>7:30am–6pm. <br /> 50 weeks per year.</span>
        </div>

        <div class="stat-item">
          <strong>Since 1986</strong>
          <span>Part of local families’ stories, routines and milestones.</span>
        </div>
      </div>
    </section>

    <section class="section" id="about">
      <div class="container">
        <div class="founder-wrap">
          <div class="founder-visual">
            <figure class="founder-card">
              <Image
                src={differenceImage}
                width={320}
                class="founder-portrait"
                alt="An archival portrait of the late Betty Spears"
              />
              <figcaption>Betty Spears, 1926–2012</figcaption>
            </figure>
          </div>
          <div>
            <p class="section-kicker" style="margin-bottom: 0.6rem;">
              Our story
            </p>
            <h2 class="section-heading" style="margin: 0 0 0.9rem;">
              Betty's was established in 1986
            </h2>
            <p class="section-lead" style="margin-top: 0;">
              The centre is named after the late Betty Spears (1926–2012), who -
              alongside June deLorenzo - worked tirelessly to secure state and
              federal funding in the 1980s for shift-working families,
              especially mothers, at the State Transit Authority. What they
              built was, to our knowledge, one of the first 24-hour child care
              centres in Sydney. We’re no longer open around the clock, but it’s
              with pride that we carry that same spirit forward today.
            </p>
          </div>
        </div>

        <div class="feature-grid">
          {
            whyItems.map((item) => (
              <article class="feature-card">
                <div
                  class="feature-icon"
                  aria-hidden="true"
                  set:html={featureIcons[item.icon]}
                />
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>

        <div class="about-carousel" data-carousel>
          <div class="about-carousel-viewport">
            <div class="about-slide is-active">
              <div class="section-panel about-slide-text">
                <p class="section-kicker" style="margin-bottom: 0.6rem;">
                  Relationships
                </p>
                <h3
                  style="margin: 0 0 0.9rem; font-size: clamp(1.45rem, 2.3vw, 2rem); color: var(--heading);"
                >
                  It really is about the relationships at Betty’s
                </h3>
                <p>
                  Relationships between children and educators are based on
                  mutual trust and respect for individuals. All children feel
                  known and cared about by the educators in the centre.
                </p>
                <p>
                  Children and families can expect to see, and do see, familiar
                  caring faces every day they come to the centre. We put
                  policies and procedures in place to make this happen – for
                  example, flexible, child-focused rostering of key staff.
                </p>
              </div>
              <div class="about-slide-visual">
                <Image
                  src={groupImage}
                  width={700}
                  alt="A child painting a cardboard tube at the art table"
                />
              </div>
            </div>

            <div class="about-slide">
              <div class="section-panel about-slide-text">
                <p class="section-kicker" style="margin-bottom: 0.6rem;">
                  About us
                </p>
                <h3
                  style="margin: 0 0 0.9rem; font-size: clamp(1.45rem, 2.3vw, 2rem); color: var(--heading);"
                >
                  Run by families, for families
                </h3>

                <p>
                  Betty Spears is a not-for-profit, parent-governed centre where
                  decisions are shaped by families and community. Not for profit
                  means that all of the income we receive in fees and Government
                  subsidies goes directly to the centre budget to be used for
                  the benefit of children and families.
                </p>
                <p>
                  The day to day running of the centre is the responsibility of
                  the Centre Director who reports to our volunteer Board of
                  Directors – all parents themselves. The Centre Director and
                  Board meet each month to discuss issues relating to the centre
                  operation and all parents whose children attend Betty’s are
                  welcome to attend.
                </p>
              </div>
              <div class="about-slide-visual">
                <Image
                  src={familyImage}
                  width={700}
                  alt="Children engaged in imaginative indoor play at Betty Spears"
                />
              </div>
            </div>

            <div class="about-slide">
              <div class="section-panel about-slide-text">
                <p class="section-kicker" style="margin-bottom: 0.6rem;">
                  Part of the neighbourhood
                </p>
                <h3
                  style="margin: 0 0 0.9rem; font-size: clamp(1.45rem, 2.3vw, 2rem); color: var(--heading);"
                >
                  Woven into the local community
                </h3>
                <p>
                  Betty’s is well known in the local area and we continue to
                  build relationships with individuals and organisations within
                  our area.
                </p>
                <p>
                  Many of our families have shared several of their children
                  with us over the course of years. We even have some parents
                  and staff at Betty’s that came to Betty’s as children
                  themselves.
                </p>
              </div>
              <div class="about-slide-visual">
                <Image
                  src={educatorImage2}
                  width={700}
                  alt="An educator reading with a group of children outdoors"
                />
              </div>
            </div>

            <div class="about-slide">
              <div class="section-panel about-slide-text">
                <p class="section-kicker" style="margin-bottom: 0.6rem;">
                  Our educators
                </p>
                <h3
                  style="margin: 0 0 0.9rem; font-size: clamp(1.45rem, 2.3vw, 2rem); color: var(--heading);"
                >
                  Long serving educators
                </h3>
                <p>
                  The long-serving nature of our educators is one of Betty’s
                  greatest strengths. Families know they can trust familiar
                  faces, stable routines and deep relationships that grow over
                  time.
                </p>
                <p>
                  We care about our staff and are proud of the fact that we have
                  minimal staff turnover at Betty’s. Our longest serving members
                  of staff have been at Betty’s for over twenty years with many
                  of our Educators working at Betty’s for close to ten years.
                </p>
                <p>
                  Every room has a university-qualified Early Childhood Teacher
                  alongside Diploma-qualified educators, plus our own trusted
                  list of permanent relief staff, so a sick day never means an
                  unfamiliar face.
                </p>
              </div>
              <div class="about-slide-visual">
                <Image
                  src={educatorImage1}
                  width={700}
                  alt="An educator sitting with a group of children during circle time"
                />
              </div>
            </div>
          </div>

          <div class="about-carousel-controls">
            <button
              type="button"
              class="carousel-arrow carousel-arrow-prev"
              aria-label="Previous"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg
              >
            </button>
            <div class="carousel-dots" aria-hidden="true">
              <span class="carousel-dot is-active"></span>
              <span class="carousel-dot"></span>
              <span class="carousel-dot"></span>
              <span class="carousel-dot"></span>
            </div>
            <button
              type="button"
              class="carousel-arrow carousel-arrow-next"
              aria-label="Next"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg
              >
            </button>
          </div>
        </div>
      </div>

      <div class="stats-band">
        <div class="container stats-band-grid">
          <div class="stat-item">
            <strong>Since 1986</strong>
            <span
              >Part of local families’ stories, routines and milestones.</span
            >
          </div>
          <div class="stat-item">
            <strong>20+ years</strong>
            <span
              >Some educators have been here for decades, creating continuity
              and trust.</span
            >
          </div>
          <div class="stat-item">
            <strong>Exceeding NQS</strong>
            <span>3 of 7 quality areas</span>
          </div>

          <div class="stat-item">
            <strong>Parent-led</strong>
            <span>Community governance remains central.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-white" id="curriculum">
      <div class="container">
        <p class="section-kicker">Curriculum</p>
        <h2 class="section-heading">
          Play-based, and led by the children themselves
        </h2>

        <div class="learning-grid">
          <div class="life-carousel" data-carousel>
            <div class="life-carousel-viewport">
              <figure class="life-slide is-active">
                <Image
                  src={learningImage}
                  width={700}
                  alt="A child painting at an outdoor art table at Betty Spears"
                />
              </figure>
              <figure class="life-slide">
                <Image
                  src={educatorImage2}
                  width={700}
                  alt="An educator reading with a group of children outdoors"
                />
              </figure>
              <figure class="life-slide">
                <Image
                  src={familyImage}
                  width={700}
                  alt="Children engaged in imaginative indoor play at Betty Spears"
                />
              </figure>
              <figure class="life-slide">
                <Image
                  src={groupImage}
                  width={700}
                  alt="Children gathered together around a shared activity at Betty Spears"
                />
              </figure>
              <figure class="life-slide">
                <Image
                  src={educatorImage1}
                  width={700}
                  alt="An educator sitting with a group of children during circle time"
                />
              </figure>
              <figure class="life-slide">
                <Image
                  src={outdoorImage2}
                  width={700}
                  alt="Children playing at the mud kitchen and water play area at Betty Spears"
                />
              </figure>
              <figure class="life-slide">
                <Image
                  src={outdoorImage1}
                  width={700}
                  alt="Children walking the garden pathway at Betty Spears"
                />
              </figure>
              <figure class="life-slide">
                <Image
                  src={outdoorGardenImage}
                  width={700}
                  alt="Children watering plants in the garden at Betty Spears"
                />
              </figure>
            </div>

            <div class="about-carousel-controls">
              <button
                type="button"
                class="carousel-arrow carousel-arrow-prev"
                aria-label="Previous"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg
                >
              </button>
              <div class="carousel-dots" aria-hidden="true">
                <span class="carousel-dot is-active"></span>
                <span class="carousel-dot"></span>
                <span class="carousel-dot"></span>
                <span class="carousel-dot"></span>
                <span class="carousel-dot"></span>
                <span class="carousel-dot"></span>
                <span class="carousel-dot"></span>
                <span class="carousel-dot"></span>
              </div>
              <button
                type="button"
                class="carousel-arrow carousel-arrow-next"
                aria-label="Next"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg
                >
              </button>
            </div>
          </div>

          <div class="section-panel learning-copy">
            <p>
              At Betty’s, learning grows naturally from children’s interests,
              relationships and everyday play. We believe children thrive when
              they have time, space and trusted adults who understand their
              needs.
            </p>
            <p>
              Play is how children make sense of the world – building curiosity,
              confidence and the courage to try new things.
            </p>
            <p class="section-lead">
              Our play-based program follows Australia’s national curriculum for
              early childhood, which sees childhood as a time of belonging,
              being and becoming. It’s built around five learning outcomes: a
              strong sense of identity, connection to and contribution to their
              world, a strong sense of wellbeing, confident and involved
              learning, and effective communication.
            </p>
          </div>
        </div>

        <div class="life-grid">
          <div>
            <p class="section-kicker">Life at Betty’s</p>
            <h3
              style="margin: 0 0 0.9rem; font-size: clamp(1.45rem, 2.3vw, 2rem); color: var(--heading);"
            >
              Nature, food and shared routines – every day
            </h3>
            <p class="section-lead">
              Betty’s is known for its generous outdoor spaces, where children
              run, dig, climb, notice and explore. Fresh air, open-ended play
              and time in nature are part of the rhythm of the day – alongside
              fresh food and calm, connected mealtimes. Even our youngest
              toddlers have their own patch to explore, with a sensory walk and
              vegetable garden in the 0–2s outdoor area – picking herbs and
              watering the garden are big favourites.
            </p>
          </div>

          <div class="life-carousel" data-carousel>
            <div class="life-carousel-viewport">
              <figure class="life-slide is-active">
                <Image
                  src={bushGardenImage}
                  width={700}
                  alt="The bush garden at Betty Spears"
                />
                <figcaption>Bush garden</figcaption>
              </figure>
              <figure class="life-slide">
                <Image
                  src={ducklingsImage}
                  width={700}
                  alt="The Ducklings outdoor play area at Betty Spears"
                />
                <figcaption>Ducklings play area</figcaption>
              </figure>
              <figure class="life-slide">
                <Image
                  src={heroImage}
                  width={700}
                  alt="The renovated outdoor play area at Betty Spears"
                />
                <figcaption>Renovated play area</figcaption>
              </figure>
              <figure class="life-slide">
                <Image
                  src={ducklingsOutdoorImage}
                  width={700}
                  alt="The Ducklings outdoor area at Betty Spears"
                />
                <figcaption>Ducklings outdoor area</figcaption>
              </figure>
            </div>

            <div class="about-carousel-controls">
              <button
                type="button"
                class="carousel-arrow carousel-arrow-prev"
                aria-label="Previous"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg
                >
              </button>
              <div class="carousel-dots" aria-hidden="true">
                <span class="carousel-dot is-active"></span>
                <span class="carousel-dot"></span>
                <span class="carousel-dot"></span>
                <span class="carousel-dot"></span>
              </div>
              <button
                type="button"
                class="carousel-arrow carousel-arrow-next"
                aria-label="Next"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg
                >
              </button>
            </div>
          </div>
        </div>

        <p class="section-kicker" style="margin-top: 3.2rem;">
          Food & nutrition
        </p>
        <h3
          style="margin: 0 0 0.9rem; font-size: clamp(1.45rem, 2.3vw, 2rem); color: var(--heading);"
        >
          Fresh food, shared routines and healthy habits
        </h3>

        <div class="food-grid">
          <div class="food-copy section-panel">
            <p>
