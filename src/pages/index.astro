import ducklingsImage from '../assets/current-site/ducklinks-play-area.jpeg'
import frontSignImage from '../assets/current-site/bettys-front-sign-2.jpg'
import ducklingsOutdoorImage from '../assets/current-site/duckliings-outdoor-1.jpg'
import ducklingsDeckImage from '../assets/current-site/ducklings-play-2.jpeg'
import lawnImage from '../assets/current-site/outdoor-area-1.jpeg'

// Hero photos get several sizes so phones don't download desktop-sized files
const heroSlides = await Promise.all(
  [
    heroImage,
    outdoorImage1,
    outdoorGardenImage,
    bushGardenImage,
    lawnImage,
    ducklingsImage,
    ducklingsOutdoorImage,
    ducklingsDeckImage,
    educatorImage2,
    frontSignImage
  ].map((src) =>
    getImage({
      src,
      widths: [640, 1024, 1440, 1920],
      sizes: '100vw',
      quality: 60
    })
  )
)

const feeTable = [
  { age: 'Under 2 years', fee: '$178.50' },
  { age: '2–3 years', fee: '$176.20' },
  { age: '3–5 years', fee: '$176.00' }
]

const philosophyItems = [
  {
    letter: 'C',
    title: 'Community & belonging',
    description:
      'A community-based centre fostering respect and understanding for ourselves, each other and the wider community.'
  },
